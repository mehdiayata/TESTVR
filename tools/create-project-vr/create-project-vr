#!/usr/bin/env bash
set -euo pipefail

tool_path=$(readlink -f -- "${BASH_SOURCE[0]}")
tool_dir=$(dirname -- "$tool_path")
template_dir="$tool_dir/template"
port=5173
quest_ip=

usage() {
  cat <<'EOF'
Usage : create-project-vr [--port=5132] [--quest-ip=192.168.1.75]

À lancer dans un dossier de projet vide sous Debian WSL.
Crée une base WebXR, construit Node/Vite et Blender dans Docker,
puis démarre le serveur HTTPS. --quest-ip est utile si la détection
automatique de l'adresse Windows échoue.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --port=*) port=${arg#--port=} ;;
    --quest-ip=*) quest_ip=${arg#--quest-ip=} ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Option inconnue : $arg" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ ! "$port" =~ ^[0-9]+$ ]] || (( 10#$port < 1024 || 10#$port > 65535 )); then
  echo 'Le port doit être un entier entre 1024 et 65535.' >&2
  exit 2
fi
port=$((10#$port))

valid_ip() {
  local value=$1 octet
  local -a octets
  [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  IFS=. read -r -a octets <<< "$value"
  for octet in "${octets[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
}

detect_windows_ip() {
  command -v ipconfig.exe >/dev/null 2>&1 || return 1
  local addresses
  addresses=$(timeout 5 ipconfig.exe 2>/dev/null | tr -d '\r' | awk '/IPv4/ {print $NF}' || true)
  printf '%s\n' "$addresses" | awk '/^192\.168\./ {print; exit}'
  if [[ -z "$addresses" ]]; then return 1; fi
}

if [[ -z "$quest_ip" ]]; then
  quest_ip=$(detect_windows_ip || true)
fi
if [[ -z "$quest_ip" ]]; then
  if [[ -t 0 ]]; then
    read -r -p 'Adresse IPv4 du PC Windows sur le Wi-Fi/LAN du Quest : ' quest_ip
  else
    echo 'Adresse du PC non détectée. Relancez avec --quest-ip=ADRESSE_IPV4.' >&2
    exit 2
  fi
fi
if ! valid_ip "$quest_ip"; then
  echo "Adresse IPv4 invalide : $quest_ip" >&2
  exit 2
fi

if find . -mindepth 1 -maxdepth 1 ! -name .git -print -quit | grep -q .; then
  echo 'Le dossier doit être vide (un dépôt .git existant est accepté).' >&2
  exit 2
fi
if command -v ss >/dev/null 2>&1 && [[ -n $(ss -ltnH "sport = :$port") ]]; then
  echo "Le port $port est déjà utilisé." >&2
  exit 2
fi
command -v docker >/dev/null 2>&1 || { echo 'Docker est introuvable.' >&2; exit 2; }
docker compose version >/dev/null
docker info >/dev/null

project_name=$(basename -- "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g' | cut -c1-24)
project_hash=$(printf '%s' "$PWD" | sha256sum | cut -c1-8)
compose_name="vr_${project_name}_${project_hash}"

cp -a "$template_dir/." .
cat > .env <<EOF
VR_PORT=$port
VR_QUEST_IP=$quest_ip
COMPOSE_PROJECT_NAME=$compose_name
HOST_UID=$(id -u)
HOST_GID=$(id -g)
EOF

echo 'Construction des conteneurs Vite et Blender…'
docker compose build app blender
docker compose up -d app

ready=false
if command -v curl >/dev/null 2>&1; then
  for _ in $(seq 1 30); do
    if curl --silent --show-error --insecure --fail --max-time 2 \
      "https://localhost:$port/" --output /dev/null 2>/dev/null; then
      ready=true
      break
    fi
    sleep 1
  done
fi

echo
if [[ "$ready" == true ]]; then
  echo 'Projet WebXR prêt.'
else
  echo 'Les conteneurs ont démarré ; vérifiez leur état avec docker compose ps.'
fi
echo "PC :    https://localhost:$port"
echo "Quest : https://$quest_ip:$port"
echo 'Complétez docs-agent/PROJECT.md, puis demandez à Codex de lire AGENTS.md et docs-agent/.'
echo 'Codex pourra ensuite lancer sh scripts/check-env.sh.'
echo 'Le navigateur peut afficher un avertissement pour le certificat HTTPS local.'
